# ---- Host / base of the co-located data tree ----
VITE_DATA_URL=https://d3nbgbhk5goaof.cloudfront.net/data

# Hydrography
VITE_STREAMS_PMTILES=https://d3nbgbhk5goaof.cloudfront.net/data/streams.pmtiles
VITE_NETWORK_GRAPH_URL=https://d3nbgbhk5goaof.cloudfront.net/data/network_graph.json

# ---- 15-day forecast tree ----
# Stream style tables are traversed as
#   <base>/<date partition>/<map-styles dir>/<styleset dir>/styles.{json,bin}
# e.g. forecast15/year=2026/month=07/day=10/map-styles/q-time-series/styles.json
# Every segment below is configurable so the tree can be reorganized without code changes.
VITE_FORECAST15_BASE=https://d3nbgbhk5goaof.cloudfront.net/data/forecast15
VITE_FORECAST_DATE_PARTITION=year={YYYY}/month={MM}/day={DD}
VITE_MAP_STYLES_DIR=map-styles
# per-styleset folders under VITE_MAP_STYLES_DIR (keys match the stream style picker)
VITE_STYLES_DIR_FORECAST15=q-time-series
VITE_STYLES_DIR_MAXFLOW=max-flow
VITE_STYLES_DIR_TIMETOPEAK=time-to-peak
VITE_STYLES_DIR_Q95=q95
VITE_FORECAST_STYLES_JSON=styles.json
VITE_FORECAST_STYLES_BIN=styles.bin
VITE_FORECAST_DEFAULT_DATE=2026-07-10
VITE_FORECAST_ZARR_BASE=https://d14ritg1bypdp7.cloudfront.net

# ---- Flood library (FLDPLN per-tile zarr stores, schema tiles-1.3.x) ----
# Root serving manifest.json + lat=*/lon=*/<TILE>.zarr.
# NOTE: not uploaded to the CDN yet — local dev serves ~/data/fldpln-merged/tiles-zarr
# via the data/fim symlink; set this to the CDN prefix once the stores are published.
VITE_FIM_DATA_URL=https://d3nbgbhk5goaof.cloudfront.net/data/fim

# ---- Retrospective daily discharge Zarr store ----
VITE_RETROSPECTIVE_DAILY_ZARR=https://d2grb3c773p1iz.cloudfront.net/retrospective/daily.zarr
