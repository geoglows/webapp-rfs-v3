# Header components
VITE_LOGO_SRC=https://cdn.apps.geoglows.org/static/images/geoglows-logo-nav.webp
VITE_LOGO_HREF=/
VITE_LOGO_ALT=GEOGLOWS
# The logo file's native size, not how it is drawn - used to get the aspect ratio correct
VITE_LOGO_WIDTH=354
VITE_LOGO_HEIGHT=60
VITE_APP_TITLE=River Forecast System v3
VITE_APP_DESCRIPTION=Interactive global river discharge forecasts and flood maps from the GEOGLOWS River Forecast System

# Defaults not meant to be overridden
VITE_MIN_FLOOD_MAPS_ZOOM=7

# Max reaches to generate FIM for. Driven by hardware and MapLibre limits, not stylistic choices or preferences
VITE_MAX_FLOOD_REACHES=75

# Default map camera, overridden by the URL hash if it exists.
# basemaps: [environment, light, dark, streetsOSM, satelliteEsri, topoEsri, topoUsgs]
VITE_MAP_DEFAULT_BASEMAP=environment
VITE_MAP_CENTER_LON=0
VITE_MAP_CENTER_LAT=20
VITE_MAP_ZOOM=1.5

# The outline the map draws around rivers the user has saved
VITE_SAVED_RIVERS_HIGHLIGHT=true
VITE_SAVED_RIVERS_COLOR=
VITE_SAVED_RIVERS_BORDER_WIDTH=3

# Settings and preferences defaults
# language: [en, es, fr], theme: [light, dark], others: [true, false]
VITE_PREFERENCES_DEFAULT_LANGUAGE=en
VITE_PREFERENCES_DEFAULT_THEME=dark
VITE_SETTINGS_MAP_LEGEND_VISIBLE=true
VITE_SETTINGS_SHADED_WARNING_LEVELS=true

# User accounts (@geoglows/geoglows-auth). Overridden by .env.local for a local supabase.
VITE_SUPABASE_URL=https://oreyydrsbsghgulhmgzx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Lij4Ly_vB9nu5EjHRznfGg_QQ2poTYj
VITE_PORTAL_URL=https://apps.geoglows.org
