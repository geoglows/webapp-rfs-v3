# Header components
VITE_LOGO_SRC=https://cdn.apps.geoglows.org/static/images/geoglows-logo-nav.webp
VITE_LOGO_HREF=/
VITE_LOGO_ALT=GEOGLOWS
# The logo file's own pixel size, not the size it is drawn at — the stylesheet fixes that at 30px
# tall. The browser only needs the ratio, and only so that it can reserve the right space before
# the file arrives instead of shifting the header once it does. Restate these when swapping in a
# logo of a different shape, or the reserved box is briefly the old logo's.
VITE_LOGO_WIDTH=354
VITE_LOGO_HEIGHT=60
VITE_APP_TITLE=River Forecast System v3
VITE_APP_DESCRIPTION=Interactive global river discharge forecasts and flood maps from the GEOGLOWS hydrological model, with 15-day forecasts, retrospective records, and on-demand flood inundation mapping for any river reach.

# Defaults not meant to be overridden
VITE_MIN_FLOOD_MAPS_ZOOM=7

# Most reaches one flood map may span. This is a browser/MapLibre capability limit, not a
# preference: past it the corridor grid the worker allocates and the canvas MapLibre drapes over
# the map outgrow what a tab will give them, and the page dies rather than draws slowly. Raise it
# only after testing on the hardware you expect, and expect to move it very little.
VITE_MAX_FLOOD_REACHES=50

# The camera the map opens on, overridden by the URL hash whenever a link carries one.
# basemaps: [environment, light, dark, streetsOSM, satelliteEsri, topoEsri, topoUsgs]
VITE_MAP_DEFAULT_BASEMAP=environment
VITE_MAP_CENTER_LON=0
VITE_MAP_CENTER_LAT=20
VITE_MAP_ZOOM=1.5

# The outline the map draws around rivers the user has saved. HIGHLIGHT is only the starting state
# of the Settings checkbox — each device can flip it, and what it chooses wins from then on. With
# the outline off, saving still works and the rivers still appear in "My saved rivers"; it is only
# the map that stops drawing them. Colour and width are not exposed to the user: leave the colour
# blank to keep the stylesheet's own light/dark pair, or set it to pin both themes, and the heart in
# the charts panel, to one colour. The width is how far the outline shows past the stream line on
# each side, in pixels.
VITE_SAVED_RIVERS_HIGHLIGHT=true
VITE_SAVED_RIVERS_COLOR=
VITE_SAVED_RIVERS_BORDER_WIDTH=3

# Settings and preferences defaults
# language: [en, es, fr], theme: [light, dark], others: [true, false]
VITE_PREFERENCES_DEFAULT_LANGUAGE=en
VITE_PREFERENCES_DEFAULT_THEME=dark
VITE_SETTINGS_MAP_LEGEND_VISIBLE=true
VITE_SETTINGS_SHADED_WARNING_LEVELS=true
