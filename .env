# ---- Host / base of the co-located data tree ----
VITE_DATA_URL=https://d3nbgbhk5goaof.cloudfront.net/data

# Hydrography
VITE_STREAMS_PMTILES=https://d3nbgbhk5goaof.cloudfront.net/data/streams.pmtiles
VITE_NETWORK_GRAPH_URL=https://d3nbgbhk5goaof.cloudfront.net/data/network_graph.json

# ---- 15-day forecast tree ----
# javascript will traverse year=YYYY/month=MM/day=DD/summaries/app-styles
VITE_FORECAST15_BASE=https://d3nbgbhk5goaof.cloudfront.net/data/forecast15
VITE_FORECAST_STYLES_JSON=styles.json
VITE_FORECAST_STYLES_BIN=styles.bin
VITE_FORECAST_DEFAULT_DATE=2026-07-10
VITE_FORECAST_ZARR_BASE=https://d14ritg1bypdp7.cloudfront.net

# ---- Flood-library tile (FLDPLN) ----
# Full URL of the tile directory, plus the tile name and the package's file names.
VITE_FLOOD_TILE_URL=https://d3nbgbhk5goaof.cloudfront.net/data/v1/tiles/N40W104_demo
VITE_FLOOD_TILE_NAME=N40W104_demo
VITE_FLOOD_TILE_META=meta.json
VITE_FLOOD_TILE_FLOWS=flows.json
VITE_FLOOD_TILE_LIBRARY=library.parquet
VITE_FLOOD_TILE_STREAMS=streams.parquet

# ---- Retrospective daily discharge Zarr store ----
VITE_RETROSPECTIVE_DAILY_ZARR=https://d2grb3c773p1iz.cloudfront.net/retrospective/daily.zarr
